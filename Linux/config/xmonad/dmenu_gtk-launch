#!/usr/bin/sh

system_desktop_files=$(ls /usr/share/applications)
home_desktop_files=$(ls ~/.local/share/applications)

desktop_files="$system_desktop_files'\n'$home_desktop_files"

target=$(echo "$desktop_files" | dmenu -fn 'monospace-11' -l 10 -i | tr -s '[:blank:]' | cut -d ' ' -f 2-)

if [[ -n $target ]]; then
  gtk-launch "${target}"
fi

