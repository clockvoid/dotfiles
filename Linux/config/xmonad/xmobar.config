Config
    { font = "Terminus bold 10"
    , bgColor = "black"
    , fgColor = "grey"
    , position = TopH 22
    , allDesktops = True
    , persistent = False
    , commands = [
        Run StdinReader

        , Run Cpu
            [ "-L", "20"
            , "-H", "70"
            , "--normal", "green"
            , "--high", "red"
            ] 30

        , Run Memory
            [ "-t", "Mem: <usedratio>%"
            ] 30

        , Run Battery
            [ "-t", "Bat: <acstatus>"
            , "-L", "20"
            , "-H", "40"
            , "-h", "green"
            , "-n", "yellow"
            , "-l", "red"
            , "--"
            , "-o", "<left>% (<timeleft>)"
            , "-O", "AC <left>%"
            , "-i", "FULL"
            ] 60

        , Run Date "%a %b %_d %l:%M" "date" 60

        , Run DiskU
            [ ("/", "Disk: <used>/<size>") ]
            [ "-L", "70"
            , "-H", "90"
            , "-n", "yellow"
            , "-h", "red"
            ] 30

        , Run Com "cat" ["/sys/firmware/acpi/platform_profile"] "profile" 30

        , Run Com "/home/clock/.config/xmonad/trayer-padding-icon.sh" [] "trayerpad" 30

        , Run Volume "default" "Master"
            [ "-t", "Vol: <volume>%<status>"
            , "--suffix", "False"
            , "--"
            , "--on", ""
            , "--off", " [mute]"
            ] 30
    ]
    , sepChar = "%"
    , alignSep = "}{"
    , template = "%StdinReader% }{ | %cpu% | %memory% | %battery% %profile% | <action=`pavucontrol` button=1>%default:Master%</action> | %disku% | %date% | %trayerpad%"
}
