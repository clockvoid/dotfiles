#!/bin/sh

# Select other window by using dmenu
# This is based on https://tools.suckless.org/dmenu/scripts/switch

windows=$(wmctrl -xl | tr -s '[:blank:]' | cut -d ' ' -f 3-3,5- | sed 's/^[a-zA-Z0-9-]*\.//' | sort | uniq)

# Add spaces to align the WM_NAMEs of the windows
max=$(echo "$windows" | awk '{cur=length($1); max=(cur>max?cur:max)} END{print max}')

windows=$(echo "$windows" | \
              awk -v max="$max" \
                  '{cur=length($1); printf $1; \
                    for(i=0; i < max - cur + 1; i++) printf " "; \
                    $1 = ""; printf "%s\n", $0}')

commands=$'[sleep]\n[shutdown]\n[reboot]\n'

target=$(echo "$commands$windows" | dmenu -p '' -fn 'monospace-11' -l 10 -i | tr -s '[:blank:]' | cut -d ' ' -f 2-)

if [[ -n $target ]]; then
  case $target in
    "[sleep]")
      systemctl suspend
      ;;
    "[shutdown]")
      systemctl shutdown
      ;;
    "[reboot]")
      systemctl reboot
      ;;
    *)
      wmctrl -a "$target"
      ;;
  esac
fi
